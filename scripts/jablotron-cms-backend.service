# Systemd unit — backend USB native (Linux server)
#
# Cài:
#   sudo cp scripts/jablotron-cms-backend.service /etc/systemd/system/
#   sudo sed -i "s|/www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS|$PWD|g" /etc/systemd/system/jablotron-cms-backend.service
#   sudo sed -i "s|User=giabao|User=$(whoami)|g" /etc/systemd/system/jablotron-cms-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jablotron-cms-backend
#
# Kết hợp UI Docker:
#   docker compose -f docker-compose.usb-host.yml up -d --build

[Unit]
Description=Jablotron CMS Backend (USB HID)
After=network.target

[Service]
Type=simple
User=giabao
WorkingDirectory=/www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS/backend
Environment=CMS_USB_MOCK_MODE=false
Environment=CMS_JABLOTRON_VENDOR_ID=0x16D6
Environment=CMS_JABLOTRON_PRODUCT_ID=0x0008
Environment=CMS_PUBLIC_KEY_PATH=/www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS/keys/public_key.pem
Environment=CMS_DATABASE_URL=sqlite+aiosqlite:////www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS/backend/data/cms.db
Environment=CMS_HWID_CACHE_PATH=/www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS/backend/data/hwid.cache
Environment=CMS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ExecStart=/www/wwwroot/Jablotron/JABLOTRON-ENTERPRISE-CMS/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
